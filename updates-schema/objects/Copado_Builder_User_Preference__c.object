<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Per-user Copado Builder defaults (project, Dev org, integration).</description>
    <enableReports>false</enableReports>
    <enableSearch>false</enableSearch>
    <label>Copado Builder User Preference</label>
    <nameField>
        <displayFormat>PREF-{0000}</displayFormat>
        <label>Preference Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Copado Builder User Preferences</pluralLabel>
    <sharingModel>Private</sharingModel>
<fields>
    <fullName>Environment_Id__c</fullName>
    <description>Preferred Copado Environment / Org Credential Id, or Copado AI Integration Id for DEFAULT_INTEGRATION prefs</description>
    <externalId>false</externalId>
    <label>Environment Id</label>
    <length>80</length>
    <required>true</required>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</fields>
<fields>
    <fullName>External_Key__c</fullName>
    <caseSensitive>false</caseSensitive>
    <description>UserId_ProjectId (or UserId_ALL) for upsert</description>
    <externalId>true</externalId>
    <label>External Key</label>
    <length>40</length>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>true</unique>
</fields>
<fields>
    <fullName>Project_Id__c</fullName>
    <description>Copado Project Id this preference applies to (blank = all projects)</description>
    <externalId>false</externalId>
    <label>Project Id</label>
    <length>18</length>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</fields>
</CustomObject>
