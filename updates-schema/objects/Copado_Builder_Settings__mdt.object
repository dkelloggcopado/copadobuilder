<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Configuration for Copado Builder API integration</description>
    <label>Copado Builder Settings</label>
    <pluralLabel>Copado Builder Settings</pluralLabel>
    <visibility>Public</visibility>
    <fields>
        <fullName>Actions_Webhook_Path__c</fullName>
        <description>Relative path for Copado Actions/Webhook RunJobTemplate (e.g. /services/apexrest/copado/v1/job or full webhook path). Leave blank to use in-org Job Execution DML only.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Actions Webhook Path</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Base_Url__c</fullName>
        <description>Copado AI API base URL for your region</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Base Url</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Commit_Job_Template__c</fullName>
        <description>Copado Job Template API name or Id for user-story commit (e.g. sfdx_commit_1)</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Commit Job Template</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Default_Dev_Environment_Id__c</fullName>
        <description>Salesforce Id of the leftmost Dev Copado Environment / Org Credential</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Default Dev Environment Id</label>
        <length>18</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Deploy_Job_Template__c</fullName>
        <description>Copado Job Template for Builder Deploy to Dev (e.g. builder_deploy_only). Not sfdx_deploy_1 (Promotion deploy).</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Deploy Job Template</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Deploy_Then_Commit_Job_Template__c</fullName>
        <description>Copado Job Template that deploys the Builder package into the Dev org, then commits (e.g. builder_deploy_then_commit)</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Deploy Then Commit Job Template</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Organization_Id__c</fullName>
        <description>Copado AI Platform Organization ID</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Organization Id</label>
        <length>50</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Use_Mock_API__c</fullName>
        <defaultValue>true</defaultValue>
        <description>When true, uses mock responses instead of live Copado AI API</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Use Mock API</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Validate_Deploy_Job_Template__c</fullName>
        <description>Job Template for validation deploy step (default sfdx_deploy_1 with deploymentDryRun).</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Validate Deploy Job Template</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Validate_Promote_Job_Template__c</fullName>
        <description>Job Template for Promote step of Validate (default sfdx_promote_1).</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Validate Promote Job Template</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Workspace_Id__c</fullName>
        <description>Optional default Copado AI workspace ID</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Workspace Id</label>
        <length>100</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
</CustomObject>
