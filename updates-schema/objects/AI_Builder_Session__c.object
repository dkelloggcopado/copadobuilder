<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Tracks a Copado Builder chat session from idea through deploy.</description>
    <enableActivities>true</enableActivities>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <label>AI Builder Session</label>
    <nameField>
        <label>Session Name</label>
        <type>Text</type>
    </nameField>
    <pluralLabel>AI Builder Sessions</pluralLabel>
    <sharingModel>ReadWrite</sharingModel>
<fields>
    <fullName>Org_Context_Status__c</fullName>
    <externalId>false</externalId>
    <label>Org Context Status</label>
    <length>40</length>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</fields>
<fields>
    <fullName>Org_Credential_Id__c</fullName>
    <externalId>false</externalId>
    <label>Org Credential Id</label>
    <length>18</length>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</fields>
<fields>
    <fullName>Org_Intelligence_Integration_Id__c</fullName>
    <externalId>false</externalId>
    <label>Org Intelligence Integration Id</label>
    <length>255</length>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</fields>
<fields>
    <fullName>Status__c</fullName>
    <externalId>false</externalId>
    <label>Status</label>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>New</fullName>
                <default>true</default>
                <label>New</label>
            </value>
            <value>
                <fullName>In Progress</fullName>
                <default>false</default>
                <label>In Progress</label>
            </value>
            <value>
                <fullName>Story Created</fullName>
                <default>false</default>
                <label>Story Created</label>
            </value>
            <value>
                <fullName>Code Built</fullName>
                <default>false</default>
                <label>Code Built</label>
            </value>
            <value>
                <fullName>Reviewed</fullName>
                <default>false</default>
                <label>Reviewed</label>
            </value>
            <value>
                <fullName>Tests Created</fullName>
                <default>false</default>
                <label>Tests Created</label>
            </value>
            <value>
                <fullName>Deployed</fullName>
                <default>false</default>
                <label>Deployed</label>
            </value>
            <value>
                <fullName>Committed</fullName>
                <default>false</default>
                <label>Committed</label>
            </value>
            <value>
                <fullName>Complete</fullName>
                <default>false</default>
                <label>Complete</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</fields>
<fields>
    <fullName>Last_Deploy_Job_Id__c</fullName>
    <description>Last Copado Job Execution Id from Builder Deploy (package to Dev).</description>
    <externalId>false</externalId>
    <label>Last Deploy Job Id</label>
    <length>80</length>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</fields>
<fields>
    <fullName>Last_Commit_Job_Id__c</fullName>
    <description>Last Copado Job Execution Id from Builder Commit (sfdx_commit_1).</description>
    <externalId>false</externalId>
    <label>Last Commit Job Id</label>
    <length>80</length>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</fields>
<fields>
    <fullName>Last_Job_Action__c</fullName>
    <description>Which Builder action started Last_Job_Id (Deploy, Commit, Validate).</description>
    <externalId>false</externalId>
    <label>Last Job Action</label>
    <length>40</length>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</fields>
<fields>
    <fullName>Last_Promotion_Id__c</fullName>
    <description>Last Copado Promotion Id created or used by Builder Validate.</description>
    <externalId>false</externalId>
    <label>Last Promotion Id</label>
    <length>80</length>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</fields>
</CustomObject>
