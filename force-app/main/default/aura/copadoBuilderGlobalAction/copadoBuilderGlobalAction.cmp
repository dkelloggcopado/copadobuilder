<aura:component
  implements="force:lightningQuickActionWithoutHeader"
  access="global"
  description="Global Action host for Copado Builder (Lightning Experience + menu)."
>
  <!--
    Pass compact as a Boolean expression. String "true" alone is unreliable for LWC @api booleans.
  -->
  <aura:attribute name="compact" type="Boolean" default="true" />
  <c:copadoBuilderChat utilityCompact="{!v.compact}" />
</aura:component>
