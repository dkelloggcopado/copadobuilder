<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>Hierarchy</customSettingsType>
    <description>Per-user Copado AI Personal Access Token for Copado Builder. Each Salesforce user stores their own PAT so Org Intelligence uses their User Level integration.</description>
    <enableFeeds>false</enableFeeds>
    <label>Copado Builder Auth</label>
    <visibility>Public</visibility>
    <fields>
        <fullName>Copado_AI_PAT__c</fullName>
        <description>Copado AI Personal Access Token for the running Salesforce user. Never return this value to the browser after save.</description>
        <externalId>false</externalId>
        <inlineHelpText>Create a Personal Access Token in the Copado AI Platform for your own account. Do not use a teammate&apos;s token.</inlineHelpText>
        <label>Copado AI PAT</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
</CustomObject>
