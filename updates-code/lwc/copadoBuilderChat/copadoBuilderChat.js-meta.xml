<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Copado Builder Chat</masterLabel>
    <description>Chat-guided experience for creating, building, testing, and deploying Copado user stories.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__Tab</target>
        <target>lightning__UtilityBar</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__UtilityBar">
            <property
                name="utilityCompact"
                type="Boolean"
                default="true"
                label="Compact layout"
                description="Use the compact stacked layout inside the utility panel."
            />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
